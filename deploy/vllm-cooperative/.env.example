# Copy to .env on the target host. Do not commit .env or the control key.
DML_REPO_ROOT=/absolute/path/to/DML
DML_SOURCE_COMMIT=928be4578baeae7cbc569829904bf1543bd30d39
DAYSTROM_KV_SECRET_FILE=/absolute/path/to/daystrom-kv-control.key
HF_CACHE_DIR=/absolute/path/to/huggingface-cache

VLLM_IMAGE=vllm/vllm-openai:v0.20.0
VLLM_CONTAINER_NAME=nemotron-warroom-vllm
VLLM_BIND_ADDRESS=0.0.0.0
VLLM_PORT=8000
VLLM_MODEL_PATH=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
VLLM_SERVED_MODEL=nvidia/nemotron-3-super
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_MODEL_LEN=65536
VLLM_MOE_BACKEND=marlin
VLLM_QUANTIZATION=fp4

# Durable state outside the repository for rollback metadata.
DAYSTROM_DEPLOY_STATE_DIR=/home/nvidia/.local/state/daystrom-vllm
