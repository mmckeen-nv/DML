    {
      "id": "conflicting_facts",
      "scope": {
        "tenant_id": "episode-owner",
        "client_id": "evaluation",
        "session_id": "episode-session",
        "instance_id": "agent"
      },
      "seeds": [
        {
          "alias": "runbook_a",
          "text": "Runbook A states the service port is 8000.",
          "meta": {
            "source": "runbook_a",
            "source_trust": "trusted",
            "claim_key": "service.port",
            "claim_value": 8000,
            "no_merge": true
          }
        },
        {
          "alias": "runbook_b",
          "text": "Runbook B states the service port is 9000.",
          "meta": {
            "source": "runbook_b",
            "source_trust": "trusted",
            "claim_key": "service.port",
            "claim_value": 9000,
            "no_merge": true
          }
        },
        {
          "alias": "cross_scope_canary",
          "text": "PRIVATE OTHER TENANT: service port is 65535.",
          "meta": {
            "source": "cross_scope_canary",
            "source_trust": "trusted",
            "claim_key": "service.port",
            "claim_value": 65535,
            "no_merge": true
          },
          "scope": {
            "tenant_id": "other-owner",
            "client_id": "evaluation",
            "session_id": "episode-session",
            "instance_id": "agent"
          }
        }
      ],
      "setup": [],
      "tasks": [
        {
          "id": "preserve_conflict",
          "prompt": "Retrieve both runbooks. Return separate claims runbook_a.port and runbook_b.port, citing each original record. Preserve the disagreement; do not choose one common port.",
          "truth": {
            "runbook_a.port": {
              "value": 8000,
              "evidence_aliases": [
                "runbook_a"
              ],
              "memory_key": "service.port"
            },
            "runbook_b.port": {
              "value": 9000,
              "evidence_aliases": [
                "runbook_b"
              ],
              "memory_key": "service.port"
            }
          },
          "state_expectations": []
        }
      ],
      "expected_memory_count": 2
    },
