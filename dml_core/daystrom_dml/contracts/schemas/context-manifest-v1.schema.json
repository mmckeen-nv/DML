{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.daystrom.local/daystrom/context-manifest-v1.schema.json",
  "title": "Daystrom Context Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_version",
    "scope",
    "model_id",
    "runtime_id",
    "segment_ids",
    "estimated_input_tokens",
    "created_at",
    "content_digest"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "daystrom-context-manifest-v1"
    },
    "scope": {"$ref": "#/$defs/daystrom_scope"},
    "model_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 1},
    "segment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "segment_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "estimated_input_tokens": {"type": "integer", "minimum": 0},
    "exact_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "parent_checkpoint_id": {"type": ["string", "null"]},
    "parent_manifest_id": {"type": ["string", "null"]},
    "decisions": {"type": "object", "additionalProperties": true},
    "audit": {"type": "object", "additionalProperties": true},
    "created_at": {
      "type": "number",
      "minimum": 0,
      "description": "Unix epoch seconds. Excluded from content_digest."
    },
    "content_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "$defs": {
    "daystrom_scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tenant_id"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "client_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "instance_id": {"type": ["string", "null"]},
        "thread_id": {"type": ["string", "null"]},
        "project_id": {"type": ["string", "null"]},
        "relationship_id": {"type": ["string", "null"]}
      }
    }
  }
}
